# === Yandex AI Studio (обязательно) ===
# API-ключ сервисного аккаунта, у которого есть роли на использование моделей AI Studio в этом каталоге.
# Если подключение отклоняется с 401/403 — проверьте роли аккаунта и ID каталога.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
REALTIME_MODEL=speech-realtime-max-tts-live/latest

# === Голос ===
VOICE=irina
VOICE_ROLE=formal
# Частота звука: микрофон → сервер и голос ассистента → браузер (на плохой связи можно OUT=22050)
AUDIO_IN_RATE=44100
AUDIO_OUT_RATE=44100
LANGUAGE=ru-RU
VAD_THRESHOLD=0.7
VAD_SILENCE_MS=900
# Шумовые ворота в браузере (0 — выкл.). Больше — сильнее отсекает фон, но тихую речь тоже
MIC_GATE=0.06
AGENT_SPEAKS_FIRST=1

# === База знаний ===
# По умолчанию база из папки kb/ целиком кладётся в промпт.
# Для большой базы: python scripts/upload_kb.py → вставьте полученный ID сюда (включится встроенный file_search)
VECTOR_STORE_ID=

# === Компания и расписание ===
COMPANY_NAME=АУМСОФТ
TIMEZONE=Europe/Moscow
WORK_START_HOUR=10
WORK_END_HOUR=18
LUNCH_HOUR=13
SLOT_MINUTES=60
BOOKING_HORIZON_DAYS=14
BOOKING_PREFIX=AUM

# === Уведомления (опционально) ===
# Telegram менеджеру о каждой записи: токен от @BotFather и chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email-подтверждение клиенту (кнопка в карточке записи). Пример для Яндекс Почты: smtp.yandex.ru, 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Страница менеджера /admin ===
# Задайте при публикации в интернет, тогда вход: /admin?token=...
ADMIN_TOKEN=

# Токен для MCP-эндпоинта /mcp (агент в AI Studio подключается к https://ВАШ-СЕРВЕР/mcp)
MCP_TOKEN=

# ID голосового агента из AI Studio: голос берётся оттуда (пусто = голос VOICE)
AGENT_PROMPT_ID=

# Подробный лог событий Яндекса (для отладки нарезки реплик)
DEBUG_EVENTS=0
